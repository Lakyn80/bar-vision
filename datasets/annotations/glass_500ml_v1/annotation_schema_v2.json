{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bar-vision.local/schemas/glass-profile-annotation-v2.json",
  "title": "Bar Vision glass_500ml_v1 profile annotation schema",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "profile_key",
    "raw_dir",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": "glass-profile-annotation-v2"
    },
    "dataset_id": {
      "const": "glass_500ml_v1"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_key": {
      "const": "glass_500ml_v1"
    },
    "raw_dir": {
      "type": "string",
      "pattern": "^raw/glass_500ml_v1$"
    },
    "keypoint_names": {
      "type": "array",
      "items": {
        "enum": [
          "rim_left",
          "rim_right",
          "bottom_left",
          "bottom_right",
          "rim_center",
          "bottom_center"
        ]
      },
      "uniqueItems": true
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "image",
          "profile",
          "label"
        ],
        "properties": {
          "image": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+\\.(jpg|jpeg|png|webp)$"
          },
          "profile": {
            "const": "glass_500ml_v1"
          },
          "label": {
            "enum": [
              "valid_glass",
              "no_glass",
              "wrong_glass",
              "different_glass",
              "cup",
              "bottle",
              "background_object",
              "partial_glass",
              "heavily_rotated",
              "bad_perspective",
              "glass_too_far",
              "glass_too_close"
            ]
          },
          "capture_session_id": {
            "type": "string",
            "minLength": 1
          },
          "split_group": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "description": "Normalized xyxy bounding box: x1, y1, x2, y2."
          },
          "keypoints": {
            "type": "object",
            "properties": {
              "rim_left": { "$ref": "#/$defs/keypoint" },
              "rim_right": { "$ref": "#/$defs/keypoint" },
              "bottom_left": { "$ref": "#/$defs/keypoint" },
              "bottom_right": { "$ref": "#/$defs/keypoint" },
              "rim_center": { "$ref": "#/$defs/keypoint" },
              "bottom_center": { "$ref": "#/$defs/keypoint" }
            },
            "additionalProperties": false
          },
          "mask": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "coordinate_space", "points"],
                "properties": {
                  "type": { "const": "polygon" },
                  "coordinate_space": { "const": "normalized" },
                  "points": {
                    "type": "array",
                    "minItems": 3,
                    "items": { "$ref": "#/$defs/point" }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "path"],
                "properties": {
                  "type": { "const": "file" },
                  "coordinate_space": { "const": "normalized" },
                  "path": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._/-]+\\.(png|jpg|jpeg)$"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "keypoint": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
